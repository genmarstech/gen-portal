.venv/
__pycache__/
*.pyc
*.sqlite3
sent-emails/
.env
.env.*
# The example carries no secrets and is the file DEPLOYMENT.md tells you to
# copy. Without this negation `.env.*` above hides it, and the documented first
# step of a deploy refers to a file that is not in the repository.
!.env.example
staticfiles/
.pytest_cache/

# Uploaded files. MEDIA_ROOT is a local directory in development, so a
# contact-log attachment or a company-library document written while running
# the server lands in the working tree. Committing one would put a client's
# scan — or the company's own bank mandate — into git history, where deleting
# it is a rewrite rather than a delete.
media/
