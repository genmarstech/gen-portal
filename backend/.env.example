# ─────────────────────────────────────────────────────────────────────────────
# gen-portal — backend/.env
#
#   cp backend/.env.example backend/.env    # then fill it in
#   chmod 600 backend/.env
#
# ⚠ THIS FILE IS AN EXAMPLE AND IS COMMITTED. backend/.env IS NOT, and must
#   never be — Charter 03 §III. A committed secret is not fixed by deleting it
#   in the next commit; it is in the history, and it has to be rotated.
#
#   Put NO real values here. Every value below is a placeholder or a default.
#
# DATABASE_URL and REDIS_URL are NOT here: compose.yaml supplies both from the
# top-level .env, and setting them here as well means two sources of truth for
# where the client database lives.
# ─────────────────────────────────────────────────────────────────────────────

# ---- core -------------------------------------------------------------------

# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=generate-one-do-not-reuse-this-line

DEBUG=False

# BOTH hostnames. Missing api.genmars.co.ke makes that host return 400 on every
# request, which reads as a proxy fault rather than a settings one.
ALLOWED_HOSTS=app.genmars.co.ke,api.genmars.co.ke

# BOTH origins, with scheme. Checked at boot: empty and DEBUG=False refuses to
# start, because unset fails in the most misleading way available — sign-in
# still works, and every authenticated write returns 403.
CSRF_TRUSTED_ORIGINS=https://app.genmars.co.ke,https://api.genmars.co.ke

# ---- outbound mail ----------------------------------------------------------
#
# Transactional mail — verification codes, password resets, error alerts — goes
# through Resend over HTTPS. See accounts/mail_backends.py for why the API and
# not SMTP, and config/settings.py for the DNS records Resend needs before it
# can send as genmars.co.ke.
#
# Checked at boot. With DEBUG=False, a non-sending backend or an empty key
# refuses to start — the alternative is sign-up returning 200 while the client
# waits forever for a code nobody sent.

EMAIL_BACKEND=accounts.mail_backends.ResendBackend

# Resend dashboard > API Keys. Sending permission only; it does not need full
# access. Secret — it can send mail as us to anyone.
RESEND_API_KEY=re_replace_me

# Must be on a domain verified in Resend, or every send returns 403.
DEFAULT_FROM_EMAIL=info@genmars.co.ke

# Where un-caught 500s go (AdminEmailHandler). A monitored mailbox, not an
# alias into a void — Charter 03 §IV Tier 1, "errors reach a human".
ERROR_EMAIL=info@genmars.co.ke
SERVER_EMAIL=info@genmars.co.ke

# Applies to both mail backends. A request that hangs holds a gunicorn worker.
EMAIL_TIMEOUT=10

# ---- SMTP fallback ----------------------------------------------------------
#
# Only needed if EMAIL_BACKEND is switched to
# django.core.mail.backends.smtp.EmailBackend — the escape hatch if Resend is
# ever unreachable. Zoho on 587 with STARTTLS; port 465 needs EMAIL_USE_SSL
# instead, and setting both is a configuration error Django will not warn
# about, it will simply fail to connect.
#
# EMAIL_HOST=smtp.zoho.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=info@genmars.co.ke
# An APPLICATION-SPECIFIC password (Zoho > Settings > Security > App Passwords),
# never the account password.
# EMAIL_HOST_PASSWORD=
