# Templated failure handler. Any unit can wire itself to this:
#
#     OnFailure=genmars-alert@%N.service
#
# %N — NOT %n. Both name the failing unit, but %n keeps the type suffix, so
# `OnFailure=genmars-alert@%n.service` instantiates
# `genmars-alert@genmars-uptime.service.service`. That works, and it puts a unit
# with a doubled suffix in `systemctl` output and a subject line reading
# "genmars-uptime.service failed" in the mail — both exactly the wrong kind of
# confusing at 3am. %N drops the suffix and gives `genmars-alert@genmars-uptime`.
#
# Verified on this host (systemd 259): for a unit spec-probe.service,
# %n = spec-probe.service, %N = spec-probe.
#
# The name arrives here as %i and is passed to the notify script, so the mail
# can say what broke and include that unit's journal.
#
#   sudo cp deploy/genmars-alert@.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#
# Test it without breaking anything real:
#   sudo systemctl start genmars-alert@genmars-portal-backup.service

[Unit]
Description=Genmars — alert that %i failed
Documentation=file:///opt/gen-portal/docs/DEPLOYMENT.md

[Service]
Type=oneshot
ExecStart=/opt/gen-portal/scripts/notify.sh %i

# Reads backend/.env for the Resend key and the journal for context. Both need
# more than a nobody-user, and this runs only when something has already gone
# wrong.
User=root
