# Prove the newest backup restores. See scripts/restore-test.sh for why this
# exists as its own scheduled job rather than a note in a runbook.

[Unit]
Description=Genmars portal — restore test (proves the backups are usable)
Documentation=file:///opt/gen-portal/docs/DEPLOYMENT.md
Requires=docker.service
After=docker.service

# A restore test that fails is the single most important alert on this box: it
# means the backups are not restorable, and it is discovered on a Sunday rather
# than during an incident.
OnFailure=genmars-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/gen-portal
ExecStart=/opt/gen-portal/scripts/restore-test.sh
EnvironmentFile=/opt/gen-portal/.env

[Install]
WantedBy=multi-user.target
